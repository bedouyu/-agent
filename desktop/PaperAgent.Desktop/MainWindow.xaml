<Window x:Class="PaperAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="论文格式修改 Agent"
        Width="1120"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Padding="28">
            <StackPanel>
                <TextBlock Text="新建论文项目" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,24"
                           Foreground="#667085"
                           TextWrapping="Wrap"
                           Text="项目用于归档论文、修改记录和格式规则。" />

                <TextBlock Text="项目名称" />
                <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="项目说明" />
                <TextBox Height="96"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" />

                <Button Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding CreateProjectCommand}"
                        Content="创建项目" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                <StackPanel>
                    <TextBlock Text="我的论文" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Foreground="#667085" Text="本机单人模式：WPF + Java 17 + H2" />
                </StackPanel>
            </DockPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="项目名称" Width="220" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="说明" Width="300" DisplayMemberBinding="{Binding Description}" />
                        <GridViewColumn Header="创建时间" Width="170" DisplayMemberBinding="{Binding CreatedAtDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <DockPanel Grid.Row="2" Margin="0,22,0,10">
                <Button DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding UploadDocumentCommand}"
                        Content="上传源文件" />
                <StackPanel>
                    <TextBlock Text="项目文档" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Foreground="#667085"
                               Text="推荐上传含 main.tex 的 ZIP 工程；也支持单个 TEX 和 Word 参考文档。" />
                </StackPanel>
            </DockPanel>

            <ListView Grid.Row="3"
                      ItemsSource="{Binding Documents}"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="350" DisplayMemberBinding="{Binding OriginalFileName}" />
                        <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding FileTypeDisplay}" />
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding FileSizeDisplay}" />
                        <GridViewColumn Header="上传时间" Width="170" DisplayMemberBinding="{Binding UploadedAtDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="4" Margin="0,16,0,0" Padding="12,8" Background="White">
                <TextBlock Foreground="#475467" Text="{Binding StatusMessage}" />
            </Border>
        </Grid>
    </Grid>
</Window>

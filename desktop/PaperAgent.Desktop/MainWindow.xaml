<Window x:Class="PaperAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="论文格式修改 Agent"
        Width="1480"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="新建论文项目" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,18"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Text="项目用于归档论文、修改记录和格式规则。" />

                    <TextBlock Text="项目名称" />
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="项目说明" />
                    <TextBox Height="74"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding CreateProjectCommand}"
                            Content="创建项目" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,26,0,10"
                           Text="我的项目"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                         BorderBrush="#D0D5DD"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           Margin="0,3,0,0"
                                           Foreground="#667085"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                <StackPanel>
                    <TextBlock Text="论文工作台" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Foreground="#667085" Text="本机单人模式 · Java 17 · TeX Live · H2" />
                </StackPanel>
            </DockPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" Width="350" DisplayMemberBinding="{Binding OriginalFileName}" />
                        <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding FileTypeDisplay}" />
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding FileSizeDisplay}" />
                        <GridViewColumn Header="上传时间" Width="170" DisplayMemberBinding="{Binding UploadedAtDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <DockPanel Grid.Row="2" Margin="0,8,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Command="{Binding UploadDocumentCommand}" Content="上传源文件" />
                    <Button Margin="10,8,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding CompileLatexCommand}"
                            Content="编译 LaTeX" />
                    <Button Margin="10,8,0,0"
                            Command="{Binding OpenPdfCommand}"
                            Content="用系统阅读器打开" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="选中 LaTeX 文档后可编译与预览" FontWeight="SemiBold" />
                    <TextBlock Foreground="#667085"
                               Text="推荐上传含 main.tex 的 ZIP；点击 PDF 页面可跳转到源码。" />
                </StackPanel>
            </DockPanel>

            <TabControl Grid.Row="3">
                <TabItem Header="PDF 与源码">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#D0D5DD" BorderThickness="1" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="10,5" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Margin="10,0,0,0"
                                                Padding="8,4"
                                                Content="生成 AI 建议"
                                                Click="OnGenerateAiSuggestionClick" />
                                        <TextBlock Text="{Binding SourcePath}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   Foreground="#344054"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                                <TextBox x:Name="SourceEditor"
                                         Grid.Row="1"
                                         Margin="0"
                                         Padding="10"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SourceText, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent" />

                        <Border Grid.Column="2" BorderBrush="#D0D5DD" BorderThickness="1" Background="#E4E7EC">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="10,7" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding PdfPreviewHint}" Foreground="#475467" />
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding PdfPages}"
                                         Background="#E4E7EC"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="12,8,12,14">
                                                <TextBlock Text="{Binding PageTitle}"
                                                           Margin="0,0,0,6"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#475467" />
                                                <Border BorderBrush="#98A2B3" BorderThickness="1" Background="White">
                                                    <Image Source="{Binding ImageUri}"
                                                           Stretch="Uniform"
                                                           Cursor="Hand"
                                                           MouseLeftButtonDown="OnPdfPageClick"
                                                           ToolTip="单击此页，定位到对应 LaTeX 源码" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AiTab" Header="AI 润色与格式建议">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="130" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding AiConfigurationStatus}"
                                   FontWeight="SemiBold"
                                   Foreground="#344054" />

                        <WrapPanel Grid.Row="1" Margin="0,10,0,4" VerticalAlignment="Center">
                            <TextBlock Text="任务" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="AiModePicker" Width="120" SelectedIndex="0" Margin="0,0,18,0">
                                <ComboBoxItem Content="语言润色" Tag="POLISH" />
                                <ComboBoxItem Content="格式建议" Tag="FORMAT" />
                            </ComboBox>
                            <TextBlock Text="模型" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="170"
                                      ItemsSource="{Binding AiModels}"
                                      SelectedItem="{Binding AiSelectedModel, Mode=TwoWay}" />
                        </WrapPanel>

                        <StackPanel Grid.Row="2" Margin="0,4,0,10">
                            <TextBlock Text="在此选择任务和模型，再回到“PDF 与源码”选中片段并点击“生成 AI 建议”。"
                                       Foreground="#667085" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AiRequestStatus}"
                                       Foreground="#475467" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="选中的原文" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding AiOriginalText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <Button DockPanel.Dock="Top"
                                        Content="复制建议"
                                        Click="OnCopyAiSuggestionClick"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,4" />
                                <TextBox Text="{Binding AiSuggestedText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Grid>

                        <DockPanel Grid.Row="4" Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="修改说明" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding AiExplanation, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="编译日志">
                    <TextBox Margin="8"
                             Padding="10"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding CompilationLog, Mode=OneWay}" />
                </TabItem>
            </TabControl>

            <Border Grid.Row="4" Margin="0,10,0,0" Padding="12,8" Background="White">
                <TextBlock Foreground="#475467" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
